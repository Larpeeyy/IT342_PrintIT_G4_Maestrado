<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PrintITMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/printit_maroon</item>
        <item name="colorPrimaryVariant">@color/printit_maroon_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/printit_maroon</item>
        <item name="colorSecondaryVariant">@color/printit_maroon_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorAccent">@color/printit_maroon</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/printit_maroon</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>

        <item name="materialButtonStyle">@style/Widget.PrintIT.Button</item>
    </style>

    <style name="Widget.PrintIT.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/printit_maroon</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>