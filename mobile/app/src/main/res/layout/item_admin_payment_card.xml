<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvPaymentCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PAY-000"
        android:textColor="#111827"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPaymentStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Student Name"
        android:textColor="#667085"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPaymentDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Order • File • Provider"
        android:textColor="#667085"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_status_gray"
            android:gravity="center"
            android:minWidth="100dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Completed"
            android:textColor="#555555"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPaymentAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="P 0.00"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>