<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOPBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_maroon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="PrintIT"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotificationBell"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_soft"
                android:gravity="center"
                android:text="🔔"
                android:textColor="#9B2C3A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileBadge"
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_profile_badge"
                android:gravity="center"
                android:text="AD"
                android:textColor="#9B2C3A"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ADMIN NAVIGATION -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFFFFF"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/navAdminDashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_maroon"
                    android:gravity="center"
                    android:minWidth="120dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Dashboard"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navAdminUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_soft"
                    android:gravity="center"
                    android:minWidth="90dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Users"
                    android:textColor="#9B2C3A"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navAdminPayments"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_soft"
                    android:gravity="center"
                    android:minWidth="110dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Payments"
                    android:textColor="#9B2C3A"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navAdminOrders"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_soft"
                    android:gravity="center"
                    android:minWidth="90dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Orders"
                    android:textColor="#9B2C3A"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvWelcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Dashboard"
                android:textColor="#111827"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcomeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Monitor users and approve staff registration requests."
                android:textColor="#667085"
                android:textSize="15sp" />

            <!-- SUMMARY CARDS -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Users"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTotalUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="All accounts"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Students"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStudents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Student accounts"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Approved Staff"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvApprovedStaff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Allowed access"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pending Staff"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPendingStaff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Needs action"
                        android:textColor="#667085"
                        android:textSize="12sp" />

                </LinearLayout>

            </GridLayout>

            <!-- ORDERS PER DAY GRAPH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Orders Per Day"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.printit.mobile.features.admin.dashboard.AdminLineChartView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="14dp" />

            </LinearLayout>

            <!-- REVENUE PER MONTH GRAPH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Revenue Per Month"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.printit.mobile.features.admin.dashboard.AdminBarChartView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="14dp" />

            </LinearLayout>

            <!-- PENDING STAFF REQUESTS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pending Staff Requests"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPendingStaffMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Loading pending staff requests..."
                    android:textColor="#667085"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/pendingStaffContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>